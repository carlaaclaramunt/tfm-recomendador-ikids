# Copia este fichero como .env y rellena los valores
# Nunca comprometas el fichero .env al repositorio

# Clave de la API de Anthropic (Claude)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a utilizar (opcional, por defecto claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Directorios de trabajo (opcional)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# -----------------------------------------------------------------------------
# Notificaciones de caducidad por correo (scripts/notificar_caducidad.py)
# -----------------------------------------------------------------------------
# Solo necesarias si se va a lanzar el envío real. Para auditar el
# contenido sin enviar nada, usar `--dry-run` y pueden omitirse.

# Servidor SMTP (p.ej. smtp.gmail.com, smtp-mail.outlook.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cuenta-emisora@dominio.com
SMTP_PASS=app-password-generado-por-el-proveedor

# Remitente visible (opcional: por defecto SMTP_USER)
EMAIL_FROM=cuenta-emisora@dominio.com

# Destinatario de las notificaciones (p.ej. info@i-kids.es)
EMAIL_TO=info@i-kids.es