# Copia este fichero como .env y rellena los valores
# Nunca comprometas el fichero .env al repositorio

# Clave de la API de Anthropic (Claude)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a utilizar (opcional, por defecto claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Directorios de trabajo (opcional)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed